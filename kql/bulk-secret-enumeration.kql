// Bulk secret enumeration
// Flags a single principal reading or listing an abnormal number of
// distinct secrets in a short window: the signature of an attacker who has
// landed on a compromised identity and is harvesting everything the vault
// holds, as opposed to an application reading the one or two secrets it
// normally uses.
//
// Table: AzureDiagnostics (Key Vault category "AuditEvent") or the
// resource-specific AZKVAuditLogs table if that's enabled on your workspace.
// Adjust the table name below to match your diagnostic setting.

AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| where OperationName in ("SecretGet", "SecretList")
| where ResultType == "Success"
| extend CallerIpAddress = tostring(CallerIpAddress_s)
| extend PrincipalId = tostring(identity_claim_oid_g)
| extend VaultName = tostring(Resource)
| summarize
    DistinctSecretsAccessed = dcount(id_s),
    TotalCalls = count(),
    IpAddresses = make_set(CallerIpAddress, 5)
    by PrincipalId, VaultName, bin(TimeGenerated, 15m)
| where DistinctSecretsAccessed >= 10
| order by DistinctSecretsAccessed desc
