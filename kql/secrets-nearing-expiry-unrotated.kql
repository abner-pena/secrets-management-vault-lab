// Secrets nearing expiry with no rotation activity
// Cross-references SecretNearExpiry events against SecretSet operations to
// catch a secret that has no rotation automation wired to it before it
// expires and breaks whatever depends on it, instead of after. A
// SecretNearExpiry event with no matching SecretSet in the following
// 35 days means either the runbook failed silently or nothing was ever
// configured to rotate that secret at all.

let nearExpiryEvents = AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| where OperationName == "SecretNearExpiry"
| extend SecretName = tostring(id_s)
| extend VaultName = tostring(Resource)
| project SecretName, VaultName, ExpiryWarningTime = TimeGenerated;
let rotationEvents = AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| where OperationName == "SecretSet"
| where ResultType == "Success"
| extend SecretName = tostring(id_s)
| extend VaultName = tostring(Resource)
| project SecretName, VaultName, RotatedTime = TimeGenerated;
nearExpiryEvents
| join kind=leftouter (rotationEvents) on SecretName, VaultName
| where isnull(RotatedTime) or RotatedTime < ExpiryWarningTime or RotatedTime > ExpiryWarningTime + 35d
| summarize LatestWarning = max(ExpiryWarningTime) by SecretName, VaultName
| order by LatestWarning asc
